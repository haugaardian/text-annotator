{
  "name": "text-annotator",
  "version": "1.0.0",
  "description": "Annotate text into typed, interval-based segments",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit --watch",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --watch",
