    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "wink-eng-lite-model": "https://github.com/winkjs/wink-eng-lite-model/releases/download/1.3.1/wink-eng-lite-model-1.3.1.tgz",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "ts-jest": "^29.4.6",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
