{
    "projects": [
        {
            "displayName": "unit",
            "preset": "ts-jest",
            "testEnvironment": "node",
            "moduleNameMapper": {
                "^@core/(.*)$": "<rootDir>/src/core/$1"
            },
            "extensionsToTreatAsEsm": [".ts"],
            "transform": {
                "^.+\\.tsx?$": [
                    "ts-jest",
                    {
                        "tsconfig": "tsconfig.json",
                        "diagnostics": false,
                        "useESM": true,
                        "isolatedModules": true
                    }
                ]
            },
            "testMatch": ["<rootDir>/src/**/?(*.)+(spec|test).[jt]s"],
            "testPathIgnorePatterns": ["<rootDir>/src/node-dependent/"],
            "setupFilesAfterEnv": ["jest-extended/all", "<rootDir>/jest-matchers.ts"]
        },
        {
            "displayName": "integration",
            "preset": "ts-jest",
            "testEnvironment": "node",
            "maxWorkers": 1,
            "moduleNameMapper": {
                "^@core/(.*)$": "<rootDir>/src/core/$1"
            },
            "extensionsToTreatAsEsm": [".ts"],
            "transform": {
                "^.+\\.tsx?$": [
                    "ts-jest",
                    {
                        "tsconfig": "tsconfig.json",
                        "diagnostics": false,
                        "useESM": true,
                        "isolatedModules": true
                    }
                ]
            },
            "testMatch": ["<rootDir>/src/node-dependent/**/*.spec.[jt]s"],
            "setupFilesAfterEnv": ["jest-extended/all", "<rootDir>/jest-matchers.ts"]
        }
    ]
}
